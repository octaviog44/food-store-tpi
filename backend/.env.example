# URL de conexión a PostgreSQL. Reemplazar usuario y contraseña.
DATABASE_URL=postgresql://postgres:password@localhost:5432/food_store_db

# Clave secreta para firmar los JWT.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar_por_una_clave_generada

# Algoritmo de firma del JWT
ALGORITHM=HS256

# Minutos de validez del token (consigna: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen permitido por CORS (frontend)
FRONTEND_ORIGIN=http://localhost:5173